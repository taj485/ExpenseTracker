# --- Postgres -----------------------------------------------------------------

POSTGRES_USER=expensetracker
POSTGRES_PASSWORD=
POSTGRES_DB=expensetracker
POSTGRES_HOST_PORT=5432

# --- MinIO --------------------------------------------------------------------
# The root credentials double as the API's S3 access key and secret key.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=receipt-images

# --- API ----------------------------------------------------------------------
# Origin of the deployed Angular client, e.g. https://expenses.example.com.
# CORS will not match until this is set.
CORS_ALLOWED_ORIGIN=

# Token validation fails until these match your Auth0 tenant.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Receipt extraction is unavailable without this.
GEMINI_API_KEY=

#CloudFlare tunnel token
CF_TUNNEL_TOKEN=