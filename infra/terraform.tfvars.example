api_app_name               = "app-expensetracker-prod"
static_web_app_name        = "swa-expensetracker-prod"
auth0_domain               = "dev-xxxxxxxx.us.auth0.com"
auth0_audience             = "https://api.expensetracker"
database_connection_string = "Host=xxx;Port=5432;Database=xxx;Username=xxx;Password=xxx"
storage_account_name       = "stexpensetrackerprod"
blob_container_name        = "receipt-images"
blob_temp_container_name   = "receipt-temp"

# Consumed by the receipt-analyser service, not by the API.
gemini_api_key = "xxx"

# Receipt extraction runs in expensetracker-receipt-analyser, which this configuration does not
# deploy yet. Leave blank until a broker and that service have an Azure home; extraction will fail
# in production while everything else keeps working.
kafka_bootstrap_servers        = ""
receipt_analyser_base_url      = ""
receipt_analyser_client_id     = ""
receipt_analyser_client_secret = ""
